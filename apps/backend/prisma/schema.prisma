// ==========================================
// Prisma Configuration
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserGender {
  MALE
  FEMALE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SOLD
  ARCHIVED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum NotificationType {
  COMMENT
  SYSTEM
  MODERATION
  PROMOTION
}

enum ReportTargetType {
  PRODUCT
  USER
  COMMENT
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum MediaEntityType {
  PRODUCT
  USER
}

enum MediaType {
  IMAGE
  VIDEO
}

// ==========================================
// Entities
// ==========================================

model User {
  id            String     @id @default(uuid())
  full_name     String
  email         String     @unique
  password_hash String
  phone_number  String     @unique
  gender        UserGender
  birth_date    DateTime
  avatar_url    String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  products        Product[]
  conversations_1 Conversation[] @relation("UserOne")
  conversations_2 Conversation[] @relation("UserTwo")
  messages        Message[]
  favorites       Favorite[]
  notifications   Notification[]
  reports         Report[]

  @@map("users")
}

model Product {
  id              String           @id @default(uuid())
  user_id         String
  category_id     String
  title           String
  description     String
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("EGP")
  condition       ProductCondition
  whatsapp_number String
  status          ProductStatus    @default(PUBLISHED)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [category_id], references: [id])
  favorites Favorite[]

  @@index([status, category_id, created_at])
  @@index([user_id])
  @@map("products")
}

model Category {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  icon_url   String?
  parent_id  String?
  created_at DateTime   @default(now())

  parent   Category?  @relation("SubCategories", fields: [parent_id], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  @@map("categories")
}

model Conversation {
  id              String    @id @default(uuid())
  user_one_id     String
  user_two_id     String
  product_id      String?
  last_message_at DateTime?
  created_at      DateTime  @default(now())

  user_one User      @relation("UserOne", fields: [user_one_id], references: [id], onDelete: Cascade)
  user_two User      @relation("UserTwo", fields: [user_two_id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user_one_id, user_two_id, product_id])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [sender_id], references: [id])

  @@index([conversation_id, created_at])
  @@map("messages")
}

model Favorite {
  user_id    String
  product_id String
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([user_id, product_id])
  @@map("favorites")
}

model Notification {
  id         String           @id @default(uuid())
  user_id    String
  title      String
  body       String
  type       NotificationType
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

model Report {
  id          String           @id @default(uuid())
  reporter_id String
  target_type ReportTargetType
  target_id   String
  reason      String
  status      ReportStatus     @default(PENDING)
  created_at  DateTime         @default(now())

  reporter User @relation(fields: [reporter_id], references: [id])

  @@index([status, target_type])
  @@map("reports")
}

model Media {
  id          String          @id @default(uuid())
  entity_type MediaEntityType
  entity_id   String
  url         String
  type        MediaType       @default(IMAGE)
  order       Int             @default(0)
  created_at  DateTime        @default(now())

  @@index([entity_type, entity_id])
  @@map("media")
}
