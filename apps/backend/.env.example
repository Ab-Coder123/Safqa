PORT=3001
NODE_ENV=development

# Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safqa?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="safqa-access-secret-key-change-in-production"
JWT_REFRESH_SECRET="safqa-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Settings
UPLOAD_STORAGE="local"
MAX_FILE_SIZE_MB=5
